# Copie para .env. Nunca publique senhas ou este arquivo preenchido.
SERIAL_PORT=/dev/serial/by-id/SEU_ARDUINO
SERIAL_BAUD=115200
# IP reservado no roteador; somente rede local privada. Sem barra no final.
CAMERA_URL=http://192.168.1.80
# Mesmo valor de CAMERA_KEY em firmware/esp32_cam/include/secrets.h
CAMERA_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES
